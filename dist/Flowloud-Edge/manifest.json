{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.10.0.1",
  "version_name": "0.10.0-alpha.1",
  "default_locale": "zh_CN",
  "description": "__MSG_extensionDescription__",
  "permissions": ["storage", "unlimitedStorage", "offscreen", "activeTab", "scripting", "tts"],
  "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://[::1]/*", "https://127.0.0.1/*", "https://localhost/*", "https://[::1]/*", "https://huggingface.co/*", "https://*.huggingface.co/*", "https://*.hf.co/*", "http://*/*", "https://*/*"],
  "icons": {
    "16": "assets/flowloud-16.png",
    "32": "assets/flowloud-32.png",
    "48": "assets/flowloud-48.png",
    "128": "assets/flowloud-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup-react.html",
    "default_icon": {
      "16": "assets/flowloud-16.png",
      "32": "assets/flowloud-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+O"
      },
      "description": "__MSG_toggleReader__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/reader.css",
        "assets/flowloud-16.png",
        "assets/flowloud-32.png",
        "assets/flowloud-48.png",
        "assets/flowloud-128.png",
        "assets/flowloud-mark.svg",
        "assets/icons/play.svg",
        "assets/icons/pause.svg",
        "assets/icons/skip-back.svg",
          "assets/icons/skip-forward.svg",
          "assets/icons/maximize-2.svg",
          "assets/icons/minimize-2.svg",
          "assets/icons/stop.svg",
        "assets/icons/x.svg"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "options_page": "options-react.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http: https:"
  }
}
